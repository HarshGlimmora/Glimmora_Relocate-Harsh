# ──────────────────────────────────────────────────────────────────────────
# Glimmora backend env contract.
#
# Single source of truth. Same keys go into Render → Environment / DO App
# Platform → Environment at deploy. Override ENV=production, point
# DATABASE_URL at managed Postgres, rotate JWT_SECRET. Everything else
# copies verbatim.
# ──────────────────────────────────────────────────────────────────────────

# --- Auth ---
JWT_SECRET=change-me-to-a-real-32+-character-secret-please-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Environment ---
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (SQLite locally; managed Postgres in prod) ---
# Accepts: sqlite:///path.db | postgresql://... | postgresql+asyncpg://...
DATABASE_URL=sqlite:///glimmora.db

# --- File storage ---
RESUME_STORAGE_BACKEND=local
RESUME_STORAGE_LOCAL_DIR=./.local-storage/resumes
RESUME_STORAGE_GCS_BUCKET=glimmora-resumes-dev
RESUME_MAX_BYTES=10485760

# --- AI provider selection ---
# auto = vertex if GCP_SERVICE_ACCOUNT_JSON_B64 is set, else stub
# stub = deterministic local provider (used by tests)
# vertex = require GCP creds; production
AI_PROVIDER=auto

# --- GCP / Vertex AI ---
# Base64 of the service-account JSON. Backend derives GCP_PROJECT from it.
GCP_SERVICE_ACCOUNT_JSON_B64=
GCP_LOCATION=us-central1

# Single model used by every analysis call. Swap here to change globally.
GEMINI_MODEL=gemini-2.5-flash
# Optional: dedicated reasoning model (synthesis, country comparison).
# Falls back to GEMINI_MODEL when unset.
GEMINI_MODEL_PRO=

# --- LLM retry budget ---
# Vertex transient errors (429/503) are retried; 4xx fail fast.
LLM_MAX_RETRIES=1
LLM_INITIAL_BACKOFF=1.0
LLM_REQUEST_TIMEOUT_S=60
