# Database (PostgreSQL — use the external/public URL for local, the
# internal one for Render-hosted runtime)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# Required when running behind a proxy / on Vercel (not localhost)
AUTH_TRUST_HOST="true"

# Feature flags
NEXT_PUBLIC_APP_NAME="Glimmora Relocate"

# Glimmora FastAPI backend (analysis pipeline)
GLIMMORA_BACKEND_URL="http://localhost:8000"
